# Shopify Storefront API (Headless)
# Domínio da loja, ex.: minha-loja.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Token de acesso público da Storefront API (app personalizado ou canal Headless)
SHOPIFY_STOREFRONT_TOKEN=
# Opcional: versão da Storefront API (padrão definido em src/lib/shopify.ts)
SHOPIFY_API_VERSION=
